[Unit]
Description=Raspberry Pi Kameraübersicht
After=graphical.target display-manager.service
Wants=display-manager.service

[Service]
User=pi
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/home/pi/raspberry-kamera-uebersicht
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/python3 /home/pi/raspberry-kamera-uebersicht/main.py
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

# Sicherheit
ProtectSystem=strict
ReadWritePaths=/home/pi/raspberry-kamera-uebersicht/logs /home/pi/raspberry-kamera-uebersicht/config.json
PrivateTmp=true
NoNewPrivileges=false

[Install]
WantedBy=graphical.target
